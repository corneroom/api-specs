# Gateway integration test config. Copy to tests/.env (gitignored) and fill in.
# Use a STAGING test account — this suite runs against the live staging gateway.
GW_URL=https://app-staging-gateway-cissa23j.uc.gateway.dev/api/v1

# Primary account — the GUEST/reader identity most cases use. Hosts nothing.
TEST_EMAIL=
TEST_PASSWORD=

# Second account — a seeded bot HOST that owns bookable staging listings.
# Needed by services/booking-host-flow.mjs (host accept / decline); every other
# case runs without it. Must be a BOT host: this suite books, accepts, declines
# and cancels for real, and a genuine host gets pushed a notification for each.
TEST_HOST_EMAIL=
TEST_HOST_PASSWORD=

# STAGING Stripe SANDBOX secret key — needed ONLY by
# services/payment-dispute-resolution-flow.mjs, which closes test-mode disputes
# as won/lost (that is a secret-key call; everything else here uses the
# publishable key like the mobile SDK does). Without it those cases SKIP.
# It MUST start with sk_test_ — lib/stripe-dispute.mjs refuses anything else.
#   CLOUDSDK_CONFIG=$HOME/.gcloud/corneroom gcloud secrets versions access latest \
#     --secret=STRIPE_SECRET_KEY --project=corneroom-82fbb
STRIPE_SECRET_KEY=
